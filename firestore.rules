// Firestore security rules for the Bitcade world leaderboard.
// Publish them in the Firebase console: Firestore Database → Rules → paste → Publish.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Highest score each game will accept. Generous, just to stop absurd fakes.
    function maxScore() {
      return {
        'neon-noodle': 100000, 'wallbuster': 500000, 'star-siege': 500000, 'rock-rift': 1000000,
        'stackdown': 2000000, 'back-alley-brawl': 100000, 'circuit-chase': 1000000, 'highrise-handyman': 1000000,
        'nitro-lane': 500000, 'volley-duel': 200000, 'crater-lander': 500000, 'sky-shield': 2000000, 'hedge-hop': 500000,
        'scaffold-scramble': 500000, 'swarm-strike': 1000000, 'garden-gunner': 1000000, 'cube-hopper': 500000,
        'light-trail': 200000, 'wing-duel': 1000000, 'twin-blast': 2000000, 'mole-patrol': 1000000,
        'turbo-tour': 2000000, 'raptor-ridge': 2000000, 'marsh-marksman': 3000000,
        'pixel-peaks': 2000000, 'pop-lagoon': 5000000, 'neon-steps': 500000,
        'blast-brigade': 3000000, 'dungeon-delve': 2000000, 'lucky-line': 200000, 'rampart-rush': 2000000,
        'sky-squadron': 5000000, 'street-sweepers': 2000000, 'gem-cascade': 2000000, 'knockout-kings': 2000000,
        'tank-tactics': 2000000, 'bomb-squad': 2000000, 'paper-route': 3000000, 'soda-slinger': 3000000,
        'pipe-panic': 2000000, 'boulder-bash': 2000000, 'ten-pin-blitz': 300, 'field-day': 2000000,
        'comet-courier': 3000000, 'fence-line': 1000000, 'crate-crew': 200000, 'hilo-hustle': 500000
      };
    }

    // A well-formed score from the signed-in player, written together with their cooldown stamp (below).
    function validScore(game) {
      let d = request.resource.data;
      return request.auth != null
        && game in maxScore()
        && d.keys().hasOnly(['n', 's', 'uid', 't']) && d.keys().hasAll(['n', 's', 'uid', 't'])
        && d.n is string && d.n.matches('^[A-Z]{3}$')
        && d.s is int && d.s > 0 && d.s <= maxScore()[game]
        && d.uid == request.auth.uid
        && d.t == request.time
        && getAfter(/databases/$(database)/documents/players/$(request.auth.uid)).data.last == request.time;
    }

    // All-time boards: anyone can read; a signed-in player can add a well-formed score, never edit or delete one.
    match /boards/{game}/scores/{id} {
      allow read: if true;
      allow create: if validScore(game);
      allow update, delete: if false;
    }

    // Daily-challenge boards, one per game per local date. A score is only accepted while that date is "today"
    // somewhere in the world (UTC-12 to UTC+14), so nobody can post to an old or future day.
    function dayStart(day) { return timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10])); }
    match /daily/{game}/days/{day}/scores/{id} {
      allow read: if true;
      allow create: if game in ['stackdown', 'wallbuster', 'twin-blast', 'mole-patrol', 'wing-duel', 'gem-cascade', 'pipe-panic', 'hilo-hustle']
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.time > dayStart(day) - duration.value(14, 'h')
        && request.time < dayStart(day) + duration.value(36, 'h')
        && validScore(game);
      allow update, delete: if false;
    }

    // Weekly tournament boards, one per game per week (keyed by the week's Monday, UTC). A score is only accepted
    // during that week (with an hour's grace either side for clocks).
    match /weekly/{game}/weeks/{week}/scores/{id} {
      allow read: if true;
      allow create: if week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.time > dayStart(week) - duration.value(1, 'h')
        && request.time < dayStart(week) + duration.value(169, 'h')
        && validScore(game);
      allow update, delete: if false;
    }

    // Blip Sports world wins: one record per player, which only ever goes up by one, at most once a minute.
    function validWin() {
      let d = request.resource.data;
      return d.keys().hasOnly(['n', 's', 't']) && d.keys().hasAll(['n', 's', 't'])
        && d.n is string && d.n.matches('^[A-Z]{3}$')
        && d.s is int && d.t == request.time;
    }
    match /wins/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid && validWin() && request.resource.data.s == 1;
      allow update: if request.auth != null && request.auth.uid == uid && validWin()
        && request.resource.data.s == resource.data.s + 1
        && request.time > resource.data.t + duration.value(60, 's');
      allow delete: if false;
    }

    // Cloud saves (shared/save.js): one per sync code, at the SHA-256 of the code. Anyone with the id (so, the code)
    // can fetch it; nobody can list them. Signed-in players write them, as one JSON string of up to 200 KB.
    match /saves/{id} {
      allow get: if id.matches('^[0-9a-f]{64}$');
      allow list: if false;
      allow create, update: if request.auth != null && id.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['d', 't']) && request.resource.data.keys().hasAll(['d', 't'])
        && request.resource.data.d is string && request.resource.data.d.size() < 200000
        && request.resource.data.t == request.time;
      allow delete: if false;
    }

    // Cooldown stamp: one score post every 10 seconds per player.
    match /players/{uid} {
      allow read: if false;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['last']) && request.resource.data.last == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['last']) && request.resource.data.last == request.time
        && request.time > resource.data.last + duration.value(10, 's');
      allow delete: if false;
    }

    // Play activity (shared/activity.js) for the admin page (admin.html). A signed-in player writes their own profile
    // and adds events, never reads, edits or deletes them; only the admin's Google account can read. The admin is
    // matched by a SHA-256 of their email, so the address isn't in this public file. (Compared as hex: the rules'
    // toBase64() is the URL-safe kind, which didn't match a standard Base64 value.)
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true
        && hashing.sha256(request.auth.token.email.lower().toUtf8()).toHexString().lower() == '67756a129dd548436a572e60a67eb376b20e5477bfc276a6a097d083d62bebf5';
    }
    match /act/{uid} {
      allow read: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['n', 'dev', 'lv', 'tix', 'first', 'last'])
        && request.resource.data.last == request.time
        && (!('n' in request.resource.data) || request.resource.data.n.matches('^[A-Z]{3}$'))
        && (!('dev' in request.resource.data) || request.resource.data.dev in ['phone', 'tablet', 'desktop']);
      allow delete: if false;
      match /ev/{id} {
        allow read: if isAdmin();
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['k', 'g', 'ms', 'play', 's', 'runs', 'd', 'e', 'floor', 'at', 't'])
          && request.resource.data.keys().hasAll(['k', 'g', 't'])
          && request.resource.data.k in ['run', 'page']
          && request.resource.data.g is string && request.resource.data.g.size() <= 40
          && request.resource.data.t == request.time;
        allow update, delete: if false;
      }
    }

    // The admin page's own settings (admin.html): the players to leave out of the numbers (the admin's own devices).
    match /admin/{doc} {
      allow read, write: if isAdmin();
    }

    // Feedback from Settings and errors caught on players' pages: anyone signed in can send them, only the admin reads
    // (and can mark feedback done or clear things away).
    match /fb/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['x', 'n', 'g', 'dev', 'uid', 't'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.x is string && request.resource.data.x.size() > 0 && request.resource.data.x.size() <= 1000
        && request.resource.data.g is string && request.resource.data.g.size() <= 40
        && (!('n' in request.resource.data) || request.resource.data.n.matches('^[A-Z]{3}$'))
        && request.resource.data.t == request.time;
    }
    match /err/{id} {
      allow read, delete: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['m', 's', 'l', 'g', 'dev', 'ua', 'uid', 't'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.m is string && request.resource.data.m.size() <= 300
        && request.resource.data.s is string && request.resource.data.s.size() <= 200
        && request.resource.data.g is string && request.resource.data.g.size() <= 40
        && request.resource.data.t == request.time;
    }

    // Challenges: a player's score on a game, shared as a link (the id is random, so only people with the link find it).
    // Anyone can read one; each player keeps one result against it, their best.
    match /ch/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['a', 'an', 'g', 's', 't'])
        && request.resource.data.a == request.auth.uid
        && request.resource.data.an.matches('^[A-Z]{3}$')
        && request.resource.data.g is string && request.resource.data.g.size() <= 40
        && request.resource.data.s is int && request.resource.data.s >= 0
        && request.resource.data.t == request.time;
      allow update, delete: if false;
      match /res/{uid} {
        allow read: if true;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['n', 's', 't'])
          && request.resource.data.n.matches('^[A-Z]{3}$')
          && request.resource.data.s is int && request.resource.data.s >= 0
          && request.resource.data.t == request.time;
        allow delete: if false;
      }
    }

    // Conversations between two players (shared/inbox.js), at dm/{uidA_uidB} with the ids in order. Only the two of them
    // can read it or write to it, and each only changes their own name, "seen" time and acceptance. A new message must
    // move `last` along in the same write, at most one a second. Quick chat and challenge cards are open to anyone in
    // it; free text only once both have played each other's challenge (acc), up to 200 characters. A player someone
    // has blocked (bl/{uid}) can't send them anything.
    function other(pair) { let ids = pair.split('_'); return ids[0] == request.auth.uid ? ids[1] : ids[0]; }
    match /dm/{pair} {
      allow get: if request.auth != null && (resource == null || request.auth.uid in resource.data.m);
      allow list: if request.auth != null && request.auth.uid in resource.data.m;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['m', 'n', 'acc', 'seen', 'last'])
        && request.resource.data.m is list && request.resource.data.m.size() == 2
        && request.auth.uid in request.resource.data.m
        && request.resource.data.m[0] < request.resource.data.m[1]
        && pair == request.resource.data.m[0] + '_' + request.resource.data.m[1]
        && request.resource.data.acc.keys().hasOnly([request.auth.uid])
        && request.resource.data.seen.keys().hasOnly([request.auth.uid])
        && request.resource.data.last == request.time;
      allow update: if request.auth != null && request.auth.uid in resource.data.m
        && request.resource.data.m == resource.data.m
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n', 'acc', 'seen', 'last'])
        && request.resource.data.n.diff(resource.data.n).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.acc.diff(resource.data.acc).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.seen.diff(resource.data.seen).affectedKeys().hasOnly([request.auth.uid])
        && (request.resource.data.last == resource.data.last
          || (request.resource.data.last == request.time && request.time > resource.data.last + duration.value(1, 's')));
      allow delete: if false;
      match /m/{id} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/dm/$(pair)).data.m;
        allow create: if request.auth != null
          && request.auth.uid in getAfter(/databases/$(database)/documents/dm/$(pair)).data.m
          && getAfter(/databases/$(database)/documents/dm/$(pair)).data.last == request.time
          && request.resource.data.u == request.auth.uid && request.resource.data.t == request.time
          && request.resource.data.keys().hasOnly(['u', 'k', 'q', 'x', 'c', 'g', 's', 'vs', 't'])
          && request.resource.data.k in ['q', 'x', 'ch', 'res']
          && (request.resource.data.k != 'x' || (request.resource.data.x is string && request.resource.data.x.size() <= 200
            && getAfter(/databases/$(database)/documents/dm/$(pair)).data.acc.get(request.auth.uid, false) == true
            && getAfter(/databases/$(database)/documents/dm/$(pair)).data.acc.get(other(pair), false) == true))
          && !(exists(/databases/$(database)/documents/bl/$(other(pair)))
            && request.auth.uid in get(/databases/$(database)/documents/bl/$(other(pair))).data.u);
        allow update, delete: if false;
      }
    }
    // Each player's block list, theirs alone.
    match /bl/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Reports from the messages: the last messages of a conversation, for the admin page.
    match /rep/{id} {
      allow read, delete: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['by', 'other', 'pair', 'log', 't'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.log is string && request.resource.data.log.size() <= 5000
        && request.resource.data.t == request.time;
    }

    // Everything else stays locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
