// Firestore security rules for the Bitcade world leaderboard.
// Publish them in the Firebase console: Firestore Database → Rules → paste → Publish.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Highest score each game will accept. Generous, just to stop absurd fakes.
    function maxScore() {
      return {
        'neon-noodle': 100000, 'wallbuster': 500000, 'star-siege': 500000, 'rock-rift': 1000000,
        'stackdown': 2000000, 'back-alley-brawl': 100000, 'circuit-chase': 1000000, 'highrise-handyman': 1000000,
        'nitro-lane': 500000, 'volley-duel': 200000, 'crater-lander': 500000, 'sky-shield': 2000000, 'hedge-hop': 500000,
        'scaffold-scramble': 500000, 'swarm-strike': 1000000, 'garden-gunner': 1000000, 'cube-hopper': 500000,
        'light-trail': 200000, 'wing-duel': 1000000, 'twin-blast': 2000000, 'mole-patrol': 1000000,
        'turbo-tour': 2000000, 'raptor-ridge': 2000000, 'marsh-marksman': 3000000,
        'pixel-peaks': 2000000, 'pop-lagoon': 5000000, 'neon-steps': 500000,
        'blast-brigade': 3000000, 'dungeon-delve': 2000000, 'lucky-line': 200000, 'rampart-rush': 2000000
      };
    }

    // A well-formed score from the signed-in player, written together with their cooldown stamp (below).
    function validScore(game) {
      let d = request.resource.data;
      return request.auth != null
        && game in maxScore()
        && d.keys().hasOnly(['n', 's', 'uid', 't']) && d.keys().hasAll(['n', 's', 'uid', 't'])
        && d.n is string && d.n.matches('^[A-Z]{3}$')
        && d.s is int && d.s > 0 && d.s <= maxScore()[game]
        && d.uid == request.auth.uid
        && d.t == request.time
        && getAfter(/databases/$(database)/documents/players/$(request.auth.uid)).data.last == request.time;
    }

    // All-time boards: anyone can read; a signed-in player can add a well-formed score, never edit or delete one.
    match /boards/{game}/scores/{id} {
      allow read: if true;
      allow create: if validScore(game);
      allow update, delete: if false;
    }

    // Daily-challenge boards, one per game per local date. A score is only accepted while that date is "today"
    // somewhere in the world (UTC-12 to UTC+14), so nobody can post to an old or future day.
    function dayStart(day) { return timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10])); }
    match /daily/{game}/days/{day}/scores/{id} {
      allow read: if true;
      allow create: if game in ['stackdown', 'wallbuster', 'twin-blast', 'mole-patrol', 'wing-duel']
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.time > dayStart(day) - duration.value(14, 'h')
        && request.time < dayStart(day) + duration.value(36, 'h')
        && validScore(game);
      allow update, delete: if false;
    }

    // Weekly tournament boards, one per game per week (keyed by the week's Monday, UTC). A score is only accepted
    // during that week (with an hour's grace either side for clocks).
    match /weekly/{game}/weeks/{week}/scores/{id} {
      allow read: if true;
      allow create: if week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.time > dayStart(week) - duration.value(1, 'h')
        && request.time < dayStart(week) + duration.value(169, 'h')
        && validScore(game);
      allow update, delete: if false;
    }

    // Blip Sports world wins: one record per player, which only ever goes up by one, at most once a minute.
    function validWin() {
      let d = request.resource.data;
      return d.keys().hasOnly(['n', 's', 't']) && d.keys().hasAll(['n', 's', 't'])
        && d.n is string && d.n.matches('^[A-Z]{3}$')
        && d.s is int && d.t == request.time;
    }
    match /wins/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid && validWin() && request.resource.data.s == 1;
      allow update: if request.auth != null && request.auth.uid == uid && validWin()
        && request.resource.data.s == resource.data.s + 1
        && request.time > resource.data.t + duration.value(60, 's');
      allow delete: if false;
    }

    // Cloud saves (shared/save.js): one per sync code, at the SHA-256 of the code. Anyone with the id (so, the code)
    // can fetch it; nobody can list them. Signed-in players write them, as one JSON string of up to 200 KB.
    match /saves/{id} {
      allow get: if id.matches('^[0-9a-f]{64}$');
      allow list: if false;
      allow create, update: if request.auth != null && id.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['d', 't']) && request.resource.data.keys().hasAll(['d', 't'])
        && request.resource.data.d is string && request.resource.data.d.size() < 200000
        && request.resource.data.t == request.time;
      allow delete: if false;
    }

    // Cooldown stamp: one score post every 10 seconds per player.
    match /players/{uid} {
      allow read: if false;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['last']) && request.resource.data.last == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['last']) && request.resource.data.last == request.time
        && request.time > resource.data.last + duration.value(10, 's');
      allow delete: if false;
    }

    // Everything else stays locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
